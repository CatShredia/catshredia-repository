<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TheFirstExampleProject.Views.LoginsTableWindow"
        xmlns:vm="using:TheFirstExampleProject.ViewModels"
        x:DataType="vm:LoginWindowViewModel"
        Title="LoginsTableWindow">
    <Grid>
        <Grid RowDefinitions="Auto Auto">
            <DataGrid Grid.Row="0" ItemsSource="{Binding Logins}" IsReadOnly="True" DoubleTapped="Show_Login"
                      Name="UserDataGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="id" Binding="{Binding IdLogin}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login1}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Пароль" Binding="{Binding Password}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="1" Click="Create_Login_Button">Создать</Button>
        </Grid>
    </Grid>
</Window>