<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TheFirstExampleProject.Views.EditViews.ItemEditWindow"
        Title="ItemEditWindow">
        <Grid ColumnDefinitions="50* 50*">
        <Grid RowDefinitions="Auto Auto Auto Auto">
            <Grid Grid.Row="0" RowDefinitions="Auto Auto" Margin="10">
                <TextBlock Grid.Row="0">Название</TextBlock>
                <TextBox Grid.Row="1" Name="NameTextBox"></TextBox>
            </Grid>
            
            <Grid Grid.Row="1" RowDefinitions="Auto Auto" Margin="10">
                <TextBlock Grid.Row="0">Цена</TextBlock>
                <TextBox Grid.Row="1" Name="PriceTextBox"></TextBox>
            </Grid>
            
            <Grid Grid.Row="2" RowDefinitions="Auto Auto" Margin="10">
                <TextBlock Grid.Row="0">Описание</TextBlock>
                <TextBox Grid.Row="1" Name="DescriptionTextBox"></TextBox>
            </Grid>
            
            <Grid Grid.Row="3" RowDefinitions="Auto Auto" Margin="10" HorizontalAlignment="Right">
                <Button Grid.Row="0" Click="Create_Button_OnClick">SAVE</Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
