<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ApplicationShop.UserControls.Header">
    <Grid ColumnDefinitions="Auto Auto Auto Auto Auto Auto" RowDefinitions="Auto">
        <Button Grid.Column="0" Click="ShowEmployees" IsVisible="True" Name="EmployeeButton">Сотрудники</Button>
        <Button Grid.Column="1" Click="ShowUsers" IsVisible="True" Name="UsersButton">Покупатели</Button>
        <Button Grid.Column="2" Click="ShowProduct" IsVisible="True" Name="ProductButton">Продукты</Button>
        <Button Grid.Column="3" Click="ShowCatalog" IsVisible="True" Name="CatalogButton">Каталог</Button>
        <Button Grid.Column="4" Click="SelectUserButtonClick" Name="SelectionUserButton"></Button>
        <Button Grid.Column="5" Click="ShowDefault" Name="DefaultButton" Width="10"></Button>
    </Grid>
</UserControl>
