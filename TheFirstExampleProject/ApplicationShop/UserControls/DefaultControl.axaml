<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ApplicationShop.UserControls.DefaultControl">
    <Grid ColumnDefinitions="50* 50*">
        <Grid Grid.Column="0">
            <DataGrid Name="BasketTableDataGrid" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="idProduct" Binding="{Binding IdProductNavigation.IdProduct}" />
                    <DataGridTextColumn Header="Product" Binding="{Binding IdProductNavigation.Name}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding IdProductNavigation.Price}" />
                    <DataGridTextColumn Header="idUser" Binding="{Binding IdUserNavigation.IdUser}" />
                    <DataGridTextColumn Header="User" Binding="{Binding IdUserNavigation.Name}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>