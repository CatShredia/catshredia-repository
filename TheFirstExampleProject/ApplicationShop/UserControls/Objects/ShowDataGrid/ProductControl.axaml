<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ApplicationShop.UserControls.Objects.ProductControl">
    <Grid RowDefinitions="Auto Auto">
        <Button Grid.Row="0" Name="UserButtonCreate" Click="CreateProduct" IsVisible="False">Create</Button>
        <DataGrid Grid.Row="1" IsReadOnly="True" DoubleTapped="Show_Product"
                  Name="UserDataGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding name}" />
                <DataGridTextColumn Header="Price" Binding="{Binding price}" />
                <DataGridTextColumn Header="Provider" Binding="{Binding provider}" />
                
                <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="DeleteProduct">
                                <Image Source="avares://ApplicationShop/Assets/bin.png"
                                       Cursor="Hand" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
