<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ApplicationShop.Windows.OrderShowWindow"
        Title="OrderShowWindow">

    <Grid>
        <DataGrid IsReadOnly="True"
                  Name="OrderListDataGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding IdProductNavigation.Name}" />
                <DataGridTextColumn Header="Price" Binding="{Binding IdProductNavigation.Price}" />
                <DataGridTextColumn Header="Provider" Binding="{Binding IdProductNavigation.Provider}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>