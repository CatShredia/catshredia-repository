<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ApplicationShop.Windows.Edit.ProductEditWindow"
        Title="ProductEditWindow">
    <Grid ColumnDefinitions="50* 50*">
        <Grid Grid.Column="0" RowDefinitions="Auto Auto Auto Auto">
            <Grid Grid.Row="0" RowDefinitions="Auto Auto">
                <TextBlock Grid.Row="0" Name="SurnameProductTextBlock">Название:</TextBlock>
                <TextBox Grid.Row="1" Name="SurnameProductTextBox" Text="{Binding Name}"></TextBox>
            </Grid>
        
            <Grid Grid.Row="1"  RowDefinitions="Auto Auto">
                <TextBlock Grid.Row="0" Name="NameProductTextBlock">Цена:</TextBlock>
                <TextBox Grid.Row="1" Name="NameProductTextBox" Text="{Binding Price}"></TextBox>
            </Grid>
        
            <Grid Grid.Row="2"  RowDefinitions="Auto Auto">
                <TextBlock Grid.Row="0" Name="DescriptionProductTextBlock">Поставщик:</TextBlock>
                <TextBox Grid.Row="1" Name="DescriptionProductTextBox" Text="{Binding Provider}"></TextBox>
            </Grid>
        
            <Button Grid.Row="3" Click="CreateUser">OK</Button>
        </Grid>
    </Grid>
</Window>
