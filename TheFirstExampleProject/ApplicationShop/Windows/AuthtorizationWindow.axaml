<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ApplicationShop.Windows.AuthtorizationWindow"
        Title="AuthtorizationWindow">
    <Grid ColumnDefinitions="Auto" RowDefinitions="Auto Auto Auto">
        <Grid RowDefinitions="Auto Auto" Grid.Row="0">
            <TextBlock Grid.Row="0">Логин</TextBlock>
            <TextBox Grid.Row="1" Name="LoginTextBox"></TextBox>
        </Grid>
        <Grid RowDefinitions="Auto Auto" Grid.Row="1">
            <TextBlock Grid.Row="0">Пароль</TextBlock>
            <TextBox Grid.Row="1" Name="PasswordTextBox"></TextBox>
        </Grid>
        
        <Button Grid.Row="2" Click="AuthUser">OK</Button>
    </Grid>
</Window>