<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ApplicationShop.Windows.AuthtorizationWindow"
        Title="AuthtorizationWindow">
    <Grid ColumnDefinitions="Auto" RowDefinitions="Auto Auto Auto Auto" Margin="5">
        <Grid RowDefinitions="Auto Auto Auto" Grid.Row="0" Margin="5">
            <TextBlock Grid.Row="0">Логин</TextBlock>
            <TextBox Grid.Row="1" Name="LoginTextBox" Width="400"></TextBox>
            <TextBlock Grid.Row="2" Name="LoginValidationErrorBlock" Foreground="Red"></TextBlock>
        </Grid>
        <Grid RowDefinitions="Auto Auto Auto" Grid.Row="1" Margin="5">
            <TextBlock Grid.Row="0">Пароль</TextBlock>
            <TextBox Grid.Row="1" Name="PasswordTextBox" Width="400"></TextBox>
            <TextBlock Grid.Row="2" Name="PasswordValidationErrorBlock" Foreground="Red"></TextBlock>
        </Grid>

        <Button Grid.Row="2" Click="AuthUser" Margin="5">OK</Button>
        <TextBlock Grid.Row="3" Name="ValidationErrorBlock" Foreground="Red"></TextBlock>
    </Grid>
</Window>